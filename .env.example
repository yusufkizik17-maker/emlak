# Safe default; demo does not send credentials/customer content to external services.
APP_MODE=demo
# Required in live mode; exact application origin, no trailing path.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ or commit actual values.
OPENAI_API_KEY=
# Allowlisted cost-controlled model. Alternatives: gpt-4.1-nano
OPENAI_MODEL=gpt-4.1-mini
